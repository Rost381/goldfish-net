# real: основной аккаунт (fapi.binance.com)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# demo: Demo Trading реального аккаунта (demo-fapi.binance.com), ключи создаются в разделе Demo Trading -> API Management
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# testnet: отдельный testnet (testnet.binancefuture.com), свои ключи, не связаны с реальным аккаунтом
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
